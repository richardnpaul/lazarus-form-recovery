{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "coverageAnalysis": "off",
  "concurrency": 8,
  "timeoutMS": 10000,
  "incremental": true,
  "tsconfigFile": "tsconfig.json",
  "vitest": {
    "related": false
  },
  "mutate": ["src/**/*.ts", "!src/**/*.d.ts", "!src/vite-env.d.ts"]
}
